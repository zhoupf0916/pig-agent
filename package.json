{
  "name": "pig-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "Local-first AI agent workstation for desktop and web",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @pig-agent/server dev",
    "dev:web": "pnpm --filter @pig-agent/web dev",
    "build": "pnpm check:architecture && pnpm typecheck && pnpm --filter @pig-agent/web build",
    "start": "pnpm --filter @pig-agent/server start",
    "mock:llm": "pnpm --filter @pig-agent/server mock:llm",
    "mock:cloud": "pnpm --filter @pig-agent/server mock:cloud",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @pig-agent/contracts typecheck && pnpm --filter @pig-agent/server typecheck && pnpm --filter @pig-agent/web typecheck",
    "desktop:build": "pnpm --filter @pig-agent/desktop build",
    "desktop:dev": "pnpm --filter @pig-agent/desktop dev",
    "desktop:pack": "pnpm --filter @pig-agent/desktop pack",
    "desktop:dist": "pnpm --filter @pig-agent/desktop dist",
    "check:architecture": "node scripts/check-architecture.mjs",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "cloud:setup": "node scripts/cloud-local.mjs setup",
    "cloud:build": "pnpm build && pnpm --filter @pig-agent/cloud typecheck && pnpm --filter @pig-agent/worker typecheck && node scripts/build-cloud.mjs",
    "cloud:up": "pnpm cloud:setup && pnpm cloud:build && node scripts/cloud-local.mjs up",
    "cloud:down": "node scripts/cloud-local.mjs down",
    "cloud:status": "node scripts/cloud-local.mjs status",
    "cloud:logs": "node scripts/cloud-local.mjs logs",
    "cloud:smoke": "node scripts/smoke-cloud.mjs",
    "cloud:smoke:schedules": "node scripts/smoke-cloud-schedules.mjs",
    "cloud:smoke:conversations": "node scripts/smoke-cloud-conversations.mjs",
    "cloud:smoke:platform": "node scripts/smoke-cloud-platform.mjs",
    "cloud:smoke:collaboration": "node scripts/smoke-cloud-collaboration.mjs",
    "cloud:smoke:approvals": "node scripts/smoke-cloud-approvals.mjs",
    "cloud:backup": "node scripts/cloud-backup.mjs",
    "cloud:restore:verify": "node scripts/cloud-backup.mjs verify-restore",
    "cluster:up": "pnpm cloud:build && node scripts/cluster-local.mjs up",
    "cluster:down": "node scripts/cluster-local.mjs down",
    "cluster:status": "node scripts/cluster-local.mjs status",
    "cluster:logs": "node scripts/cluster-local.mjs logs",
    "cluster:smoke": "node scripts/smoke-cluster-control.mjs && node scripts/smoke-cluster-runners.mjs",
    "product:smoke": "pnpm build && node scripts/smoke-product.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@openai/codex": "0.153.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "concurrently": "^9.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "author": "Pig Agent contributors"
}
