# Pig Agent local defaults. Copy to .env if you want to override.

# Backend HTTP port (Vite proxies /api here during `pnpm dev`)
PORT=8787

# Persist chat sessions + settings on disk
DATA_DIR=./data

# Agent file/shell sandbox root. Relative paths resolve from the repo root.
WORKSPACE_ROOT=./sample-workspace

# OpenAI-compatible Chat Completions endpoint
# Ollama: http://127.0.0.1:11434/v1
# OpenAI: https://api.openai.com/v1
# Compatible gateways (LM Studio, vLLM, LiteLLM, etc.) also work.
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Ollama accepts any value (or empty). Cloud providers need a real key.
LLM_API_KEY=ollama

# Model id as exposed by the endpoint (`ollama list`, OpenAI model name, …)
LLM_MODEL=llama3.2

# Optional: allow the browser origin when not using the Vite proxy
WEB_ORIGIN=http://127.0.0.1:5173
