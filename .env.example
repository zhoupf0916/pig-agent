# Pig Agent local defaults. Copy to `.env` or `.env.local` (both are gitignored).
# Never commit real API keys.

# Backend HTTP port (Vite proxies /api here during `pnpm dev`)
PORT=8787

# Persist chat sessions + settings on disk
DATA_DIR=./data

# Agent file/shell sandbox root. Relative paths resolve from the repo root.
WORKSPACE_ROOT=./sample-workspace

# --- LLM (OpenAI-compatible Chat Completions) ---
# Recommended: DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Prefer one of these. LLM_API_KEY wins, then DEEPSEEK_API_KEY, then OPENAI_API_KEY.
# Placeholder only — put the real key in `.env.local`, not in git.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# OPENAI_API_KEY=
# LLM_API_KEY=

# Optional: restrict http_fetch to these host suffixes (comma-separated).
# Empty = any public host (private/loopback IPs are always blocked).
# HTTP_FETCH_ALLOWLIST=example.com,wikipedia.org

# Optional: allow the browser origin when not using the Vite proxy
WEB_ORIGIN=http://127.0.0.1:5173

# --- Optional Codex runtime (Settings → runtime=codex) ---
# Isolated CODEX_HOME (default ./data/codex-home). Do not reuse ~/.codex.
# PIG_CODEX_HOME=./data/codex-home
# CODEX_BIN=codex
# CODEX_MODEL=deepseek-flash
# Provider root for Codex Responses API — NOT the pig Chat Completions /v1 URL.
# CODEX_BASE_URL=https://api.deepseek.com/
# Keys: reuse DEEPSEEK_API_KEY above, or set CODEX_API_KEY. Never commit real keys.
